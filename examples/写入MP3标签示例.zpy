# examples/写入MP3标签示例.zpy
导入 os
导入 sys

定义 解析文件名(路径):
    文件名 = os.path.basename(路径)
    名称 = os.path.splitext(文件名)[0]
    如果 非 (" - " 在 名称):
        返回 ("", "")
    艺术家, 标题原始 = 名称.split(" - ", 1)
    标题 = 标题原始.split("_", 1)[0]
    返回 (艺术家, 标题)

定义 写入字段(文本, 长度):
    字节数据 = 文本.encode("gbk", errors="ignore")
    返回 字节数据[:长度].ljust(长度, b"\x00")

定义 写入ID3v1标签(路径, 艺术家, 标题):
    标签 = (
        b"TAG"
        + 写入字段(标题, 30)
        + 写入字段(艺术家, 30)
        + 写入字段("", 30)
        + 写入字段("", 4)
        + 写入字段("", 30)
        + 字节([0])
    )

    使用 打开(路径, "r+b") 作为 文件:
        文件.seek(0, 2)
        文件大小 = 文件.tell()
        如果 文件大小 >= 128:
            文件.seek(-128, 2)
            如果 文件.read(3) == b"TAG":
                文件.seek(-128, 2)
            否则:
                文件.seek(0, 2)
        文件.write(标签)

如果 长度(sys.argv) < 2:
    打印("用法: zpy examples/写入MP3标签示例.zpy <mp3路径>")
    抛出 SystemExit(1)

路径 = sys.argv[1]
艺术家, 标题 = 解析文件名(路径)

如果 艺术家 == "" 或 标题 == "":
    打印("文件名格式应为: 艺术家 - 歌名_任意后缀.mp3")
    抛出 SystemExit(1)

写入ID3v1标签(路径, 艺术家, 标题)
打印(f"已写入 ID3 v1 标签: 艺术家={艺术家}, 标题={标题}")
