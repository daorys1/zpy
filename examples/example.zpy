# examples/example.zpy
定义 函数(a, b):
    如果 a > b:
        # Using Chinese alias for print
        打印("a 大于 b")
        返回 a
    否则:
        打印("b 大于等于 a")
        返回 b

结果 = 函数(5, 3)
打印(f"结果是: {结果}")

循环 i 在 [1, 2, 3]:
    如果 i == 2:
        打印("遇到 2")
    否则:
        打印(f"当前是: {i}")

# Example using boolean keywords
我的真值 = 真
我的假值 = 假
如果 我的真值 与 (非 我的假值):
    打印("真值")

# New example using '长度' (len) built-in alias
列表数据 = [10, 20, 30, 40]
列表长度 = 长度(列表数据)
打印(f"列表的长度是: {列表长度}")

# Example using exception alias (will raise an error)
尝试:
    # Some code that might raise an error
    x = 1 / 0
异常 错误: # Using alias for Exception
    打印("捕获到错误！")
