# examples/读取MP3标签示例.zpy
导入 sys

定义 解析字段(字节数据):
    文本 = 字节数据.decode("gbk", errors="ignore")
    返回 文本.rstrip("\x00 ")

定义 读取ID3v1标签(路径):
    使用 打开(路径, "rb") 作为 文件:
        文件.seek(0, 2)
        如果 文件.tell() < 128:
            返回 空
        文件.seek(-128, 2)
        标签 = 文件.read(128)

    如果 标签[:3] != b"TAG":
        返回 空

    标题 = 解析字段(标签[3:33])
    艺术家 = 解析字段(标签[33:63])
    专辑 = 解析字段(标签[63:93])
    年份 = 解析字段(标签[93:97])
    注释 = 解析字段(标签[97:127])
    流派编号 = 标签[127]

    返回 {
        "标题": 标题,
        "艺术家": 艺术家,
        "专辑": 专辑,
        "年份": 年份,
        "注释": 注释,
        "流派编号": 流派编号,
    }

如果 长度(sys.argv) < 2:
    打印("用法: zpy examples/读取MP3标签示例.zpy <mp3路径>")
    抛出 SystemExit(1)

路径 = sys.argv[1]
结果 = 读取ID3v1标签(路径)

如果 结果 是 空:
    打印("未找到 ID3 v1 标签")
否则:
    打印("读取到 ID3 v1 标签:")
    循环 键, 值 在 结果.items():
        打印(f"{键}: {值}")
